<?xml version="1.0" encoding="utf-8"?>
<!-- ReyDesk design tokens (dark only) (see docs/design-system.md). Flat dictionary, no ThemeDictionaries (gotcha 0xc000027b). Translucent RDcGlow* only on Ellipse fills. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Primitive: ink + lines + text (family) -->
  <Color x:Key="RDcInk0">#FF06080C</Color>      <Color x:Key="RDcInk1">#FF080B11</Color>
  <Color x:Key="RDcInk2">#FF0E131B</Color>      <Color x:Key="RDcInk3">#FF141A24</Color>
  <Color x:Key="RDcInk3Top">#FF1A212D</Color>   <Color x:Key="RDcInk4">#FF1B2230</Color>
  <Color x:Key="RDcInk5">#FF171E29</Color>      <Color x:Key="RDcLine">#FF222A37</Color>
  <Color x:Key="RDcLineStrong">#FF323C4D</Color><Color x:Key="RDcLineInput">#FF6B7486</Color>
  <Color x:Key="RDcLineTray">#FF2A3240</Color>  <Color x:Key="RDcFg1">#FFF3F5F8</Color>
  <Color x:Key="RDcFgMuted">#FFA7B0BF</Color>   <Color x:Key="RDcFgFaint">#FF8590A2</Color>
  <Color x:Key="RDcFgDisabled">#FF6B7383</Color>
  <!-- Primitive: accent -->
  <Color x:Key="RDcAccent">#FFFFB020</Color>        <Color x:Key="RDcAccentFill">#FFFFB020</Color>
  <Color x:Key="RDcAccentFillHover">#FFFFC04D</Color><Color x:Key="RDcAccentFillPressed">#FFE69A10</Color>
  <Color x:Key="RDcAccentHover">#FFFFC04D</Color>   <Color x:Key="RDcAccentInk">#FF080B11</Color>
  <Color x:Key="RDcOnAccent">#FF080B11</Color>
  <!-- Primitive: opaque accent tints (precomputed over ink) -->
  <Color x:Key="RDcAccentDim">#FF1D1912</Color>     <Color x:Key="RDcAccentTile">#FF2E2B24</Color>
  <Color x:Key="RDcAccentTileLine">#FF433823</Color><Color x:Key="RDcAccentSelected">#FF26231C</Color>
  <Color x:Key="RDcAccentTint">#FF352F23</Color>    <Color x:Key="RDcAccentTintLine">#FF5F4A23</Color>
  <Color x:Key="RDcAccentTonalHover">#FF373123</Color><Color x:Key="RDcAccentTonalPressed">#FF483B23</Color>
  <Color x:Key="RDcRingTrack">#FF302513</Color>
  <!-- Primitive: status (family) -->
  <Color x:Key="RDcDanger">#FFFF5A5F</Color>   <Color x:Key="RDcDangerHi">#FFFF8A8E</Color>
  <Color x:Key="RDcSuccess">#FF3DDC84</Color>  <Color x:Key="RDcWarning">#FFFF8A3D</Color>
  <Color x:Key="RDcLive">#FFFF4D5E</Color>
  <Color x:Key="RDcSuccessBg">#FF1A3531</Color><Color x:Key="RDcSuccessLine">#FF215843</Color>
  <Color x:Key="RDcWarningBg">#FF352A28</Color><Color x:Key="RDcWarningLine">#FF5F3E2C</Color>
  <Color x:Key="RDcDangerBg">#FF35232C</Color> <Color x:Key="RDcDangerLine">#FF5F2E37</Color>
  <Color x:Key="RDcDangerHover">#FF3C2832</Color><Color x:Key="RDcDangerPressed">#FF532E37</Color>
  <!-- Primitive: glow (Ellipse only) -->
  <Color x:Key="RDcGlowAccent">#99FFB020</Color><Color x:Key="RDcGlowAccentEdge">#00FFB020</Color>
  <Color x:Key="RDcGlowDanger">#8CFF5A5F</Color><Color x:Key="RDcGlowDangerEdge">#00FF5A5F</Color>
  <Color x:Key="RDcGlowWarning">#80FF8A3D</Color><Color x:Key="RDcGlowWarningEdge">#00FF8A3D</Color>

  <!-- Semantic brushes -->
  <SolidColorBrush x:Key="RDBgBrush" Color="{StaticResource RDcInk1}"/>
  <SolidColorBrush x:Key="RDBgDeepBrush" Color="{StaticResource RDcInk0}"/>
  <SolidColorBrush x:Key="RDSurfaceBrush" Color="{StaticResource RDcInk2}"/>
  <SolidColorBrush x:Key="RDPanelBrush" Color="{StaticResource RDcInk3}"/>
  <SolidColorBrush x:Key="RDHoverBrush" Color="{StaticResource RDcInk4}"/>
  <SolidColorBrush x:Key="RDLineBrush" Color="{StaticResource RDcLine}"/>
  <SolidColorBrush x:Key="RDLineStrongBrush" Color="{StaticResource RDcLineStrong}"/>
  <SolidColorBrush x:Key="RDTextBrush" Color="{StaticResource RDcFg1}"/>
  <SolidColorBrush x:Key="RDTextMutedBrush" Color="{StaticResource RDcFgMuted}"/>
  <SolidColorBrush x:Key="RDTextFaintBrush" Color="{StaticResource RDcFgFaint}"/>
  <SolidColorBrush x:Key="RDTextDisabledBrush" Color="{StaticResource RDcFgDisabled}"/>
  <SolidColorBrush x:Key="RDAccentBrush" Color="{StaticResource RDcAccent}"/>
  <SolidColorBrush x:Key="RDAccentHoverBrush" Color="{StaticResource RDcAccentHover}"/>
  <SolidColorBrush x:Key="RDAccentFillBrush" Color="{StaticResource RDcAccentFill}"/>
  <SolidColorBrush x:Key="RDAccentFillHoverBrush" Color="{StaticResource RDcAccentFillHover}"/>
  <SolidColorBrush x:Key="RDAccentFillPressedBrush" Color="{StaticResource RDcAccentFillPressed}"/>
  <SolidColorBrush x:Key="RDOnAccentBrush" Color="{StaticResource RDcOnAccent}"/>
  <SolidColorBrush x:Key="RDAccentInkBrush" Color="{StaticResource RDcAccentInk}"/>
  <SolidColorBrush x:Key="RDAccentTintBrush" Color="{StaticResource RDcAccentTint}"/>
  <SolidColorBrush x:Key="RDAccentTintLineBrush" Color="{StaticResource RDcAccentTintLine}"/>
  <SolidColorBrush x:Key="RDSuccessBrush" Color="{StaticResource RDcSuccess}"/>
  <SolidColorBrush x:Key="RDWarningBrush" Color="{StaticResource RDcWarning}"/>
  <SolidColorBrush x:Key="RDDangerBrush" Color="{StaticResource RDcDanger}"/>
  <SolidColorBrush x:Key="RDLiveBrush" Color="{StaticResource RDcLive}"/>
  <SolidColorBrush x:Key="RDSuccessBgBrush" Color="{StaticResource RDcSuccessBg}"/>
  <SolidColorBrush x:Key="RDSuccessLineBrush" Color="{StaticResource RDcSuccessLine}"/>
  <SolidColorBrush x:Key="RDWarningBgBrush" Color="{StaticResource RDcWarningBg}"/>
  <SolidColorBrush x:Key="RDWarningLineBrush" Color="{StaticResource RDcWarningLine}"/>
  <SolidColorBrush x:Key="RDDangerBgBrush" Color="{StaticResource RDcDangerBg}"/>
  <SolidColorBrush x:Key="RDDangerLineBrush" Color="{StaticResource RDcDangerLine}"/>

  <!-- Component tokens -->
  <LinearGradientBrush x:Key="RDCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource RDcInk3Top}" Offset="0"/><GradientStop Color="{StaticResource RDcInk3}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RDSidebarBrush" Color="{StaticResource RDcInk2}"/>
  <SolidColorBrush x:Key="RDTitleBarBrush" Color="{StaticResource RDcInk2}"/>
  <SolidColorBrush x:Key="RDNavHoverBrush" Color="{StaticResource RDcInk3}"/>
  <SolidColorBrush x:Key="RDNavSelectedBrush" Color="{StaticResource RDcAccentSelected}"/>
  <SolidColorBrush x:Key="RDIconTileBrush" Color="{StaticResource RDcAccentTile}"/>
  <SolidColorBrush x:Key="RDIconTileLineBrush" Color="{StaticResource RDcAccentTileLine}"/>
  <SolidColorBrush x:Key="RDButtonBrush" Color="{StaticResource RDcInk5}"/>
  <SolidColorBrush x:Key="RDButtonHoverBrush" Color="{StaticResource RDcInk4}"/>
  <SolidColorBrush x:Key="RDButtonPressedBrush" Color="{StaticResource RDcLine}"/>
  <SolidColorBrush x:Key="RDTonalBrush" Color="{StaticResource RDcAccentTile}"/>
  <SolidColorBrush x:Key="RDTonalHoverBrush" Color="{StaticResource RDcAccentTonalHover}"/>
  <SolidColorBrush x:Key="RDTonalPressedBrush" Color="{StaticResource RDcAccentTonalPressed}"/>
  <SolidColorBrush x:Key="RDDangerButtonHoverBrush" Color="{StaticResource RDcDangerHover}"/>
  <SolidColorBrush x:Key="RDDangerButtonPressedBrush" Color="{StaticResource RDcDangerPressed}"/>
  <SolidColorBrush x:Key="RDInputBrush" Color="{StaticResource RDcInk4}"/>
  <SolidColorBrush x:Key="RDInputLineBrush" Color="{StaticResource RDcLineInput}"/>
  <SolidColorBrush x:Key="RDListSelectedBrush" Color="{StaticResource RDcAccentSelected}"/>
  <SolidColorBrush x:Key="RDRingTrackBrush" Color="{StaticResource RDcRingTrack}"/>
  <SolidColorBrush x:Key="RDSkeletonBrush" Color="{StaticResource RDcInk3}"/>
  <SolidColorBrush x:Key="RDSkeletonHiBrush" Color="{StaticResource RDcInk4}"/>
  <RadialGradientBrush x:Key="RDRingDiscBrush" Center="0.5,0.28" GradientOrigin="0.5,0.28" RadiusX="0.75" RadiusY="0.75">
    <GradientStop Color="#FF18202C" Offset="0"/><GradientStop Color="#FF0B1017" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="RDRingGlowAccentBrush"><GradientStop Color="{StaticResource RDcGlowAccent}" Offset="0.62"/><GradientStop Color="{StaticResource RDcGlowAccentEdge}" Offset="1"/></RadialGradientBrush>
  <RadialGradientBrush x:Key="RDRingGlowDangerBrush"><GradientStop Color="{StaticResource RDcGlowDanger}" Offset="0.62"/><GradientStop Color="{StaticResource RDcGlowDangerEdge}" Offset="1"/></RadialGradientBrush>
  <RadialGradientBrush x:Key="RDRingGlowWarningBrush"><GradientStop Color="{StaticResource RDcGlowWarning}" Offset="0.62"/><GradientStop Color="{StaticResource RDcGlowWarningEdge}" Offset="1"/></RadialGradientBrush>

  <!-- Shapes, spacing, type sizes -->
  <CornerRadius x:Key="RDRadiusXs">6</CornerRadius>  <CornerRadius x:Key="RDRadiusSm">10</CornerRadius>
  <CornerRadius x:Key="RDRadiusControl">12</CornerRadius><CornerRadius x:Key="RDRadiusCard">16</CornerRadius>
  <CornerRadius x:Key="RDRadiusDialog">16</CornerRadius><CornerRadius x:Key="RDRadiusTile">11</CornerRadius>
  <CornerRadius x:Key="RDRadiusTileSm">9</CornerRadius><CornerRadius x:Key="RDRadiusPill">999</CornerRadius>
  <Thickness x:Key="RDCardPadding">16,14,16,14</Thickness><Thickness x:Key="RDWorkspacePadding">28,20,28,20</Thickness>
  <x:Double x:Key="RDControlHeight">40</x:Double>   <x:Double x:Key="RDGap">10</x:Double>
  <x:Double x:Key="RDTypeTitle">24</x:Double>       <x:Double x:Key="RDTypeValue">18</x:Double>
  <x:Double x:Key="RDTypeSection">15</x:Double>     <x:Double x:Key="RDTypeBody">14</x:Double>
  <x:Double x:Key="RDTypeSub">13</x:Double>         <x:Double x:Key="RDTypeLabel">12</x:Double>
  <x:Double x:Key="RDTypeCaption">11</x:Double>     <x:Double x:Key="RDTypeId">22</x:Double>
  <x:Double x:Key="RDTypeSas">36</x:Double>         <x:Double x:Key="RDTypeBrand">19</x:Double>
  <!-- Fonts: App.xaml.cs replaces RDFontUi per locale (D1 probe decides the URI form) -->
  <FontFamily x:Key="RDFontUi">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter, ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
  <FontFamily x:Key="RDFontMono">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter, ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>

  <!-- WinUI system overrides so built-in controls follow the family -->
  <Color x:Key="SystemAccentColor">#FFFFB020</Color>
  <Color x:Key="SystemAccentColorLight1">#FFFFC04D</Color><Color x:Key="SystemAccentColorLight2">#FFFFB020</Color>
  <Color x:Key="SystemAccentColorLight3">#FFFFD07A</Color><Color x:Key="SystemAccentColorDark1">#FFE69A10</Color>
  <Color x:Key="SystemAccentColorDark2">#FFB8780C</Color> <Color x:Key="SystemAccentColorDark3">#FF080B11</Color>
  <Color x:Key="TextOnAccentFillColorPrimary">#FF080B11</Color>
  <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource RDcAccent}"/>
  <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource RDcInk1}"/>
  <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="RDAccentFillBrush"/>
  <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="RDAccentFillHoverBrush"/>
  <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="RDAccentFillPressedBrush"/>
  <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="RDOnAccentBrush"/>
  <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="RDInputBrush"/>
  <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="RDInputLineBrush"/>
  <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="RDTextMutedBrush"/>
  <StaticResource x:Key="TextControlBackground" ResourceKey="RDInputBrush"/>
  <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="RDInputBrush"/>
  <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="RDPanelBrush"/>
  <StaticResource x:Key="TextControlBorderBrush" ResourceKey="RDInputLineBrush"/>
  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="RDAccentBrush"/>
  <StaticResource x:Key="TextControlForeground" ResourceKey="RDTextBrush"/>
  <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="RDTextFaintBrush"/>
  <StaticResource x:Key="ContentDialogBackground" ResourceKey="RDSurfaceBrush"/>
  <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="RDLineStrongBrush"/>
  <StaticResource x:Key="InfoBarErrorSeverityBackgroundBrush" ResourceKey="RDDangerBgBrush"/>
  <StaticResource x:Key="InfoBarWarningSeverityBackgroundBrush" ResourceKey="RDWarningBgBrush"/>
  <StaticResource x:Key="InfoBarSuccessSeverityBackgroundBrush" ResourceKey="RDSuccessBgBrush"/>
  <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="RDAccentTintBrush"/>
  <StaticResource x:Key="InfoBarErrorSeverityIconBackground" ResourceKey="RDDangerBrush"/>
  <StaticResource x:Key="InfoBarWarningSeverityIconBackground" ResourceKey="RDWarningBrush"/>
  <StaticResource x:Key="InfoBarSuccessSeverityIconBackground" ResourceKey="RDSuccessBrush"/>
  <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="RDAccentBrush"/>

</ResourceDictionary>
