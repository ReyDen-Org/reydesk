  <Style x:Key="RDTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource RDInputBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource RDTextBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource RDInputLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="{ThemeResource RDControlHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="CornerRadius" Value="{ThemeResource RDRadiusControl}"/>
    <Setter Property="FontSize" Value="{ThemeResource RDTypeBody}"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="BorderElement" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" MinHeight="{TemplateBinding MinHeight}">
            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Border.BackgroundTransition>
            <Grid Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="ContentElement" VerticalAlignment="Center" IsTabStop="False" ZoomMode="Disabled"
                            HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock x:Name="PlaceholderTextContentPresenter" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource RDTextFaintBrush}"
                         VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters><Setter Target="BorderElement.BorderBrush" Value="{ThemeResource RDLineStrongBrush}"/></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource RDAccentBrush}"/>
                    <Setter Target="BorderElement.BorderThickness" Value="1.5"/>
                    <Setter Target="BorderElement.Background" Value="{ThemeResource RDPanelBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource RDLineBrush}"/>
                    <Setter Target="ContentElement.Foreground" Value="{ThemeResource RDTextDisabledBrush}"/>
                    <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource RDTextDisabledBrush}"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
