<UserControl
    x:Class="ReyDesk.Windows.Controls.RDToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rd="using:ReyDesk.Windows.Controls"
    IsTabStop="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,16,16,24">
    <Border x:Name="Root" MinHeight="44" MaxWidth="560" Padding="14,6,6,6" Background="{ThemeResource RDSurfaceBrush}" BorderBrush="{ThemeResource RDLineStrongBrush}"
            BorderThickness="1" CornerRadius="{ThemeResource RDRadiusControl}" Opacity="0">
        <Border.RenderTransform><TranslateTransform x:Name="Slide" Y="8"/></Border.RenderTransform>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <rd:RDIcon x:Name="Glyph" Size="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="Message" Grid.Column="1" FontSize="{ThemeResource RDTypeBody}" Foreground="{ThemeResource RDTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="ActionButton" Grid.Column="2" Style="{StaticResource RDGhostButton}" MinHeight="32" Padding="12,0" Visibility="Collapsed" Click="Action_Click"/>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource RDIconButton}" Width="32" Height="32" MinHeight="32" Visibility="Collapsed" Click="Close_Click"
                    AutomationProperties.Name="Close">
                <rd:RDIcon Glyph="Close" Size="16"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
