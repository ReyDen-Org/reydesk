<UserControl
    x:Class="ReyDesk.Windows.Controls.RDStatusRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rd="using:ReyDesk.Windows.Controls"
    IsTabStop="False">
    <StackPanel HorizontalAlignment="Center" Spacing="12">
        <Grid x:Name="Box" Width="232" Height="232" HorizontalAlignment="Center">
            <Ellipse x:Name="GlowAccent" Fill="{ThemeResource RDRingGlowAccentBrush}" Opacity="0"/>
            <Ellipse x:Name="GlowDanger" Fill="{ThemeResource RDRingGlowDangerBrush}" Opacity="0"/>
            <Ellipse x:Name="Disc" Width="176" Height="176" Fill="{ThemeResource RDRingDiscBrush}"/>
            <Ellipse x:Name="Track" Width="176" Height="176" Stroke="{ThemeResource RDRingTrackBrush}" StrokeThickness="2.5" Opacity="0"/>
            <Ellipse x:Name="Edge" Width="176" Height="176" StrokeThickness="1.5"/>
            <Canvas x:Name="ArcHost" Width="176" Height="176" IsHitTestVisible="False" Opacity="0">
                <Path x:Name="Arc" Stroke="{ThemeResource RDAccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.RenderTransform><RotateTransform x:Name="Spin"/></Path.RenderTransform>
                </Path>
            </Canvas>
            <rd:RDIcon x:Name="Center" Size="44" Glyph="Devices" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center"/>
            <TextBlock x:Name="Line" FontSize="{ThemeResource RDTypeSection}" FontWeight="Bold" Foreground="{ThemeResource RDTextBrush}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </StackPanel>
</UserControl>
