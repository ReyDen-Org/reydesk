<UserControl
    x:Class="ReyDesk.Windows.Controls.RDListBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rd="using:ReyDesk.Windows.Controls"
    IsTabStop="False">
    <Grid>
        <Button x:Name="Trigger" Style="{StaticResource RDListTrigger}" HorizontalAlignment="Stretch" Click="Trigger_Click" PreviewKeyDown="Trigger_KeyDown">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource RDTextBrush}"/>
                <rd:RDIcon x:Name="Chevron" Grid.Column="1" Glyph="Chevron" Size="16" Foreground="{ThemeResource RDTextMutedBrush}" RenderTransformOrigin="0.5,0.5">
                    <rd:RDIcon.RenderTransform><RotateTransform x:Name="ChevronTurn"/></rd:RDIcon.RenderTransform>
                </rd:RDIcon>
            </Grid>
        </Button>
        <Popup x:Name="Pop" IsLightDismissEnabled="True" Closed="Pop_Closed">
            <Border x:Name="PopRoot" Background="{ThemeResource RDSurfaceBrush}" BorderBrush="{ThemeResource RDLineStrongBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource RDRadiusCard}" Padding="4" Opacity="0">
                <Border.RenderTransform><TranslateTransform x:Name="PopSlide" Y="-3"/></Border.RenderTransform>
                <ListView x:Name="List" SelectionMode="Single" IsItemClickEnabled="True" ItemContainerStyle="{StaticResource RDListOptionItem}"
                          ItemClick="List_ItemClick" PreviewKeyDown="List_KeyDown" MaxHeight="304" Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" TabNavigation="Once">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="rd:RDListEntry">
                            <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
